# ============================================================
# ATENEA EHR — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ----- Django Core -----
SECRET_KEY=your-secret-key-here
DEBUG=False

# ----- Database (MariaDB) -----
DB_ENGINE=django.db.backends.mysql
DB_NAME=ateneagrunecodb
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306
DB_UNIX_SOCKET=/opt/bitnami/mariadb/tmp/mysql.sock

# ----- Email (Gmail SMTP) -----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Atenea Gruneco <your-email@gmail.com>

# ----- PostHog Analytics -----
POSTHOG_PERSONAL_API_KEY=your-posthog-api-key
POSTHOG_PROJECT_ID=your-project-id
POSTHOG_API_URL=https://us.posthog.com
POSTHOG_DAU_INSIGHT_ID=your-insight-id
POSTHOG_GROWTH_INSIGHT_ID=your-insight-id
POSTHOG_DEVICE_TYPE_INSIGHT_ID=your-insight-id
POSTHOG_IDENTIFY_COUNT_INSIGHT_ID=your-insight-id
POSTHOG_SESION_TIME_INSIGHT_ID=your-insight-id
POSTHOG_VIEWS_PER_PAGE=your-insight-id
POSTHOG_PAGES_VIEWS_PER_USER=your-insight-id
POSTHOG_DAU_PER_USER_ID=your-insight-id
POSTHOG_AUTOCAPTURE_PER_USER_ID=your-insight-id
